<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_label_placeholder"
            android:textColor="@color/widget_text_dim_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_refresh_description"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh_dark" />
    </LinearLayout>

    <!-- Period tabs: Today / Week / Month. Each is its own tappable zone since
         RemoteViews cannot host real touch gestures like swipe. -->
    <LinearLayout
        android:id="@+id/widget_period_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tab_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/widget_tab_today"
            android:textColor="@color/widget_text_dim_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tab_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/widget_tab_week"
            android:textColor="@color/widget_text_dim_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tab_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="@string/widget_tab_month"
            android:textColor="@color/widget_text_dim_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_total_placeholder"
        android:textColor="@color/widget_text_dark"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:text="@string/widget_today_placeholder"
        android:textColor="@color/widget_text_dim_dark"
        android:textSize="13sp" />

    <!-- Mode tabs: Combined / UPI / Cash. -->
    <LinearLayout
        android:id="@+id/widget_mode_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tab_combined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="@string/widget_tab_combined"
            android:textColor="@color/widget_text_faint_dark"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_tab_upi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="@string/widget_tab_upi"
            android:textColor="@color/widget_text_faint_dark"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_tab_cash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="@string/widget_tab_cash"
            android:textColor="@color/widget_text_faint_dark"
            android:textSize="10sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="9dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_dark" />

    <TextView
        android:id="@+id/widget_budget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/widget_text_dim_dark"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_faint_dark"
        android:textSize="10sp" />
</LinearLayout>
